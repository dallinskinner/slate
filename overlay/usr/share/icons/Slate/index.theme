[Icon Theme]
Name=Slate
Comment=Round app icons (from Numix-Circle) with Breeze Dark for everything else
Inherits=breeze-dark,hicolor
Directories=48/apps,48@2x/apps
Example=folder
# Recolor Breeze folder/places icons with the current accent (lime by default)
FollowsColorScheme=true

[48/apps]
Size=48
Context=Applications
MinSize=8
MaxSize=512
Type=Scalable

[48@2x/apps]
Size=48
Scale=2
Context=Applications
MinSize=8
MaxSize=512
Type=Scalable
