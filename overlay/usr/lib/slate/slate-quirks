#!/bin/sh
# Slate hardware quirks, applied at every boot by slate-quirks.service (and by the
# slate-desktop postinst). Each quirk is detected fresh, so moving a disk to other
# hardware undoes it.
POL=/etc/brave/policies/managed/slate-gpu.json

# NVIDIA GPU driven by nouveau (e.g. MacBook Pro A1398 with the GeForce GT 750M, where the
# firmware turns off the Intel GPU): Brave's GPU acceleration freezes the browser.
nouveau_nvidia() {
	for d in /sys/bus/pci/devices/*; do
		[ "$(cat "$d/vendor" 2>/dev/null)" = 0x10de ] || continue
		case "$(cat "$d/class" 2>/dev/null)" in 0x03*) ;; *) continue ;; esac
		[ -e /proc/driver/nvidia ] && return 1      # proprietary driver: acceleration is fine
		return 0
	done
	return 1
}

# Old Macs get no firmware from LVFS, and Discover shows "Failed to download metadata for
# lvfs" when it refreshes before Wi-Fi is up: turn the LVFS remote off on Apple hardware.
# The marker lets the remote come back if this disk ends up in a PC.
LVFS_MARK=/var/lib/slate/lvfs-off
lvfs_quirk() {
	command -v fwupdmgr >/dev/null 2>&1 || return 0
	vendor=${SLATE_SYS_VENDOR:-$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)}
	if [ "$vendor" = "Apple Inc." ]; then
		[ -e "$LVFS_MARK" ] && return 0
		timeout 60 fwupdmgr disable-remote lvfs --assume-yes >/dev/null 2>&1 || return 0
		mkdir -p "${LVFS_MARK%/*}"; touch "$LVFS_MARK"
	elif [ -e "$LVFS_MARK" ]; then
		timeout 60 fwupdmgr enable-remote lvfs --assume-yes >/dev/null 2>&1 && rm -f "$LVFS_MARK"
	fi
}
lvfs_quirk

if nouveau_nvidia; then
	mkdir -p "${POL%/*}"
	printf '{\n  "HardwareAccelerationModeEnabled": false\n}\n' > "$POL"
else
	rm -f "$POL"
fi
exit 0
